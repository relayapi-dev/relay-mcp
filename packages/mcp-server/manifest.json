{
  "dxt_version": "0.2",
  "name": "relay-mcp",
  "version": "0.1.0",
  "description": "The official MCP Server for the Relay API",
  "author": {
    "name": "Relay",
    "email": "support@relayapi.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stainless-sdks/relay-typescript.git"
  },
  "homepage": "https://github.com/stainless-sdks/relay-typescript/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.relayapi.dev",
  "server": {
    "type": "node",
    "entry_point": "index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "RELAY_API_KEY": "${user_config.RELAY_API_KEY}"
      }
    }
  },
  "user_config": {
    "RELAY_API_KEY": {
      "title": "api_key",
      "description": "API key (rlay_live_* or rlay_test_*)",
      "required": true,
      "type": "string"
    }
  },
  "tools": [],
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
